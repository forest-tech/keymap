;; mac-jis.kbd - Kanata config for MacBook Air (built-in JIS keyboard)
;; Design: thumb mods (eisu/space/kana), Caps = Esc / Symbol+Number.
;; Existing number pad follows forest-tech/my-karabiner-elements.
;; Recommended: Kanata v1.12.0+; macOS JIS hardware layout and ABC input source.
;;
;; IMPORTANT: confirm the device name using `kanata --list` before running.
;; Keep Karabiner-Elements complex modifications disabled while using Kanata.

;; ============================================================================
;; 0. GLOBAL SETTINGS
;; ============================================================================
(defcfg
  ;; Keys not listed in defsrc pass through unchanged.
  process-unmapped-keys yes
  ;; Restrict this JIS mapping to the BUILT-IN keyboard. External US boards
  ;; must have their own config (or firmware mapping).
  macos-dev-names-include ("Apple Internal Keyboard / Trackpad")
)

;; ============================================================================
;; 1. SOURCE KEYS - only the keys this config remaps.
;; The grid is schematic (alpha block + Caps and thumb keys), not the exact
;; physical position of every key.
;; ============================================================================
(defsrc
  q      w      e      r      t      y      u      i      o      p
  a      s      d      f      g      h      j      k      l      ;
  z      x      c      v      b      n      m      ,      .      /
  caps   eisu                 spc                  kana
)

;; ============================================================================
;; 2. VARIABLES
;; FEATURE SWITCHES - edit ONLY the value in the right column.
;;   feature-eisu:    @eisu-cmd       ON  / eisu OFF
;;   feature-space:   @space-ctrl     ON  / spc  OFF
;;                    @space-ctrl-fast = quicker Ctrl shortcuts, more risk
;;                    of accidental Ctrl while typing.
;;   feature-kana:    @kana-shift     ON  / kana OFF
;;   feature-symbol1: @caps-symbol1   ON  / esc  OFF (keep Esc)
;;   feature-symbol2: @hold-symbol2   ON  / XX   OFF
;;
;; Modes are independent. Change one value and run `kanata --check --cfg`.
;; With Symbol1 OFF, Symbol2 is unreachable.
;; ============================================================================
(defvar
  feature-eisu       @eisu-cmd
  feature-space      @space-ctrl
  feature-kana       @kana-shift
  feature-symbol1    @caps-symbol1
  feature-symbol2    @hold-symbol2

  ;; Timing unit: ms
  tap-repress-ms     180
  hold-eisu-ms       180
  hold-space-ms      190
  hold-kana-ms       180
  hold-caps-ms       180
)

;; ============================================================================
;; 3. ALIASES
;; ============================================================================
(defalias
  ;; Tap eisu, hold Command. Note that eisu/kana are macOS JIS key names.
  eisu-cmd        (tap-hold-press $tap-repress-ms $hold-eisu-ms eisu lmet)

  ;; Conservative mode waits for the hold timeout: avoids mistaken Ctrl+letter
  ;; when typing ordinary prose quickly (e.g. space then j).
  space-ctrl      (tap-hold $tap-repress-ms $hold-space-ms spc lctl)
  space-ctrl-fast (tap-hold-press $tap-repress-ms $hold-space-ms spc lctl)

  ;; Tap kana, hold Shift.
  kana-shift      (tap-hold-press $tap-repress-ms $hold-kana-ms kana lsft)

  ;; Tap Escape for Vim, hold Symbol1. Other key presses activate hold early.
  caps-symbol1    (tap-hold-press $tap-repress-ms $hold-caps-ms esc (layer-while-held symbol1))

  ;; While Caps is held, hold kana to access Symbol2 (pairs and alternates).
  hold-symbol2    (layer-while-held symbol2)
)

;; ============================================================================
;; 4. LAYERS
;; Physical keycodes assume a macOS JIS layout:
;;   lbrc is '@'        S-lbrc is '`'      rbrc is '['
;;   S-rbrc is '{'      apo is ':'         S-apo is '*'
;;   eql is '^'         S-min is '='       S-¥ is '|'
;;   S-\ is '}'        \ is ']'           ro is '_'
;; Mac JIS Yen key can be rendered as yen or backslash depending on input source.
;; We deliberately do NOT use (unicode ...), to keep terminal key events.
;; ============================================================================

;; --- BASE: alpha keys pass through; only Caps and thumb keys are remapped ---
(deflayer base
  _      _      _      _      _      _      _      _      _      _
  _      _      _      _      _      _      _      _      _      _
  _      _      _      _      _      _      _      _      _      _
  $feature-symbol1 $feature-eisu      $feature-space      $feature-kana
)

;; --- SYMBOL 1 / NUMBER: while Caps is held ---
;; Output:    -  @  %  `  !    {  7  8  9  ,
;;            -  '  /  :  *    (  4  5  6  <
;;            -  $  =  -  |    [  1  2  3  /
;;                        SPACE = 0
;; Q/A/Z are left alone; they are difficult to reach with Caps held.
(deflayer symbol1
  _      lbrc   S-5    S-lbrc S-1    S-rbrc 7      8      9      ,
  _      S-7    /      apo    S-apo  S-8    4      5      6      S-,
  _      S-4    S-min  min    S-¥    rbrc   1      2      3      /
  _      _                    0                    $feature-symbol2
)

;; --- SYMBOL 2 / NUMBER: while Caps AND kana are held ---
;; Output:    -  @  %  ~  &    }  7  8  9  .
;;            -  "  ?  ;  #    )  4  5  6  >
;;            -  ^  +  _  \    ]  1  2  3  ?
;;                        SPACE = 0
;; kana is XX: do not trigger a second kana or Shift while the layer key is held.
(deflayer symbol2
  _      lbrc   S-5    S-eql  S-6    S-\    7      8      9      .
  _      S-2    S-/    scln   S-3    S-9    4      5      6      S-.
  _      eql    S-scln ro     ¥      \      1      2      3      S-/
  _      _                    0                    XX
)
